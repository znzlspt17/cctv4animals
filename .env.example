# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cctv?sslmode=disable

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Face Recognition
FACE_DB_PATH=face_db
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR=retinaface
DEEPFACE_DETECTOR_REALTIME=retinaface
DEEPFACE_DISTANCE_METRIC=cosine
FACE_MIN_CONFIDENCE=0.90
FACE_MIN_SIZE=112
FACE_BLUR_THRESHOLD=100.0
FACE_MIN_CONFIDENCE_REALTIME=0.80
FACE_MIN_SIZE_REALTIME=56
RECOGNITION_THRESHOLD=0.40
DUPLICATE_THRESHOLD=0.25
ALLOW_FORCE_REGISTER=false
RECOGNITION_FRAME_SKIP=3
ENABLE_RECOGNITION_LOG=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30
LOG_DEDUP_SECONDS=10

# Animal line crossing
ANIMAL_LINE_START_X=0
ANIMAL_LINE_START_Y=860
ANIMAL_LINE_END_X=1920
ANIMAL_LINE_END_Y=860

# Person counter
PERSON_VIDEO_SOURCE=0
PERSON_CAMERA_ID=cam_01
PERSON_LINE_START_X=0
PERSON_LINE_START_Y=360
PERSON_LINE_END_X=1280
PERSON_LINE_END_Y=360
PERSON_FRAME_SKIP=10
PERSON_ROI_X=0
PERSON_ROI_Y=100
PERSON_ROI_W=1280
PERSON_ROI_H=520
PERSON_YOLO_MODEL=models/4people-yolo26n.pt
PERSON_CONFIDENCE_THRESHOLD=0.5
PERSON_SNAPSHOT_DIR=snapshots
