DB_BACKEND=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=deepface_live
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
FACE_DB_PATH=face_db
DEEPFACE_MODEL=VGG-Face
DEEPFACE_DETECTOR=retinaface
DEEPFACE_DETECTOR_REALTIME=retinaface
DEEPFACE_DISTANCE_METRIC=cosine
FACE_MIN_CONFIDENCE=0.90
FACE_MIN_SIZE=112
FACE_BLUR_THRESHOLD=100.0
FACE_MIN_CONFIDENCE_REALTIME=0.80
FACE_MIN_SIZE_REALTIME=56
RECOGNITION_THRESHOLD=0.40
ALLOW_FORCE_REGISTER=false
RECOGNITION_FRAME_SKIP=3
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30
LOG_DEDUP_SECONDS=10
